# ── Database ──
POSTGRES_DB=fuelnow
POSTGRES_USER=fuelnow
POSTGRES_PASSWORD=changeme

# URL SQLAlchemy async — obligatoire, à construire avec vos vars ci-dessus
DATABASE_URL=postgresql+asyncpg://fuelnow:changeme@db:5432/fuelnow

# ── ETL ──
SOURCE_DATASET_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/exports/json
SOURCE_FORMAT=json
ETL_CRON=0 6 * * *
ETL_BE_CRON=0 7 * * *
ETL_MIN_ROWS=5000
ETL_MIN_RATIO=0.8

# ── Statbel (prix maximum officiels Belgique) ──
STATBEL_API_URL=https://bestat.statbel.fgov.be/bestat/api/views/9e9cf394-6c54-4d81-8013-7124a8c4bf15/result/JSON

# ── API ──
RATE_LIMIT_PER_MIN=60
SEARCH_RADIUS_MAX_M=30000
CACHE_TTL_S=900
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=

# ── Alerting (optionnel) ──
ALERT_WEBHOOK_URL=

# ── Proxy / TLS ──
PUBLIC_HOSTNAME=fuelnow.local
ACME_EMAIL=admin@fuelnow.local
WEB_PORT=8080
